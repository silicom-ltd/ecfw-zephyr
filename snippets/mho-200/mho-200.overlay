 *
 * DTS overlay file for MHO-200 Switch card.
 */
/ {
	smbus1: smbus1 {
		compatible = "microchip,xec-smbus";
		i2c = <&i2c_smb_3>;
		#address-cells = <1>;
		#size-cells = <0>;

		mfd3: mp2992@60 {
			compatible = "mps,mp2985";
			reg = <0x60>;

			mfd3_temp_1: core_vdd_temp {
				compatible = "mps,mp2985-temp";
				page = <0>;
			};
			mfd3_temp_2: vddh_temp {
				compatible = "mps,mp2985-temp";
				page = <1>;
			};
			mfd3_iout_1: core_vdd_iout {
				compatible = "mps,mp2985-iout";
				page = <0>;
			};
			mfd3_iout_2: vddh_iout {
				compatible = "mps,mp2985-iout";
				page = <1>;
			};
			mfd3_vout_1: core_vdd_vout {
				compatible = "mps,mp2985-vout";
				page = <0>;
			};
			mfd3_vout_2: vddh_vout {
				compatible = "mps,mp2985-vout";
				page = <1>;
			};
			mfd3_vin_2: vddh_vin {
				compatible = "mps,mp2985-vin";
				page = <1>;
			};
		};
		mfd9: mp2985@61 {
			compatible = "mps,mp2985";
			reg = <0x61>;

			mfd9_temp_1: gop_vdd_temp {
				compatible = "mps,mp2985-temp";
				page = <0>;
			};
			mfd9_temp_2: 3v3_left_temp {
				compatible = "mps,mp2985-temp";
				page = <1>;
			};
			mfd9_iout_1: gop_vdd_iout {
				compatible = "mps,mp2985-iout";
				page = <0>;
			};
			mfd9_iout_2: 3v3_left_iout {
				compatible = "mps,mp2985-iout";
				page = <1>;
			};
			mfd9_vout_1: gop_vdd_vout {
				compatible = "mps,mp2985-vout";
				page = <0>;
			};
			mfd9_vout_2: 3v3_left_vout {
				compatible = "mps,mp2985-vout";
				page = <1>;
			};
			mfd9_vin_2: 3v3_left_vin {
				compatible = "mps,mp2985-vin";
				page = <1>;
			};
		};
		mfd10: mp2985@62 {
			compatible = "mps,mp2985";
			reg = <0x62>;

			mfd10_temp_1: vdda_temp {
				compatible = "mps,mp2985-temp";
				page = <0>;
			};
			mfd10_temp_2: 3v3_right_temp {
				compatible = "mps,mp2985-temp";
				page = <1>;
			};
			mfd10_iout_1: vdda_iout {
				compatible = "mps,mp2985-iout";
				page = <0>;
			};
			mfd10_iout_2: 3v3_right_iout {
				compatible = "mps,mp2985-iout";
				page = <1>;
			};
			mfd10_vout_1: vdda_vout {
				compatible = "mps,mp2985-vout";
				page = <0>;
			};
			mfd10_vout_2: 3v3_right_vout {
				compatible = "mps,mp2985-vout";
				page = <1>;
			};
			mfd10_vin_2: 3v3_right_vin {
				compatible = "mps,mp2985-vin";
				page = <1>;
			};
		};
		mfd6: crps@58 {
			compatible = "ocp,crps";
			reg = <0x58>;

			mfd6_temp_amb: psu1_ambient {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <141>;
			};
			mfd6_temp_hot: psu1_hot {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <142>;
			};
			mfd6_iout: psu1_iout {
				compatible = "ocp,crps-iout";
				page = <0>;
			};
			mfd6_pin: psu1_pin {
				compatible = "ocp,crps-power";
				page = <0>;
			};
		};
		mfd8: crps@59 {
			compatible = "ocp,crps";
			reg = <0x59>;

			mfd8_temp_amb: psu2_ambient {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <141>;
			};
			mfd8_temp_hot: psu2_hot {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <142>;
			};
			mfd8_iout: psu2_iout {
				compatible = "ocp,crps-iout";
				page = <0>;
			};
			mfd8_pin: psu2_pin {
				compatible = "ocp,crps-power";
				page = <0>;
			};
		};
	};
	zephyr,user {
		sw-die-temp-sensors = <&mfd9_temp_2>,
				      <&mfd10_temp_2>,
				      <&mfd3_temp_2>,
				      <&mfd6_temp_amb>,
				      <&mfd6_temp_hot>,
				      <&mfd3_temp_1>,
				      <&mfd9_temp_1>,
				      <&mfd10_temp_1>,
				      <&mfd8_temp_amb>,
				      <&mfd8_temp_hot>,
				      <&switch_maestro_temp>;

		sw-amb-temp-sensors = <&switch_temp0>, <&switch_temp1>;

		sw-volt-sensors = <&mfd9_vout_2>,
				  <&mfd10_vout_2>,
				  <&mfd3_vout_2>,
				  <&mfd3_vout_1>,
				  <&mfd9_vout_1>,
				  <&mfd10_vout_1>;

		sw-curr-sensors = <&mfd9_iout_2>,
				  <&mfd10_iout_2>,
				  <&mfd3_iout_2>,
				  <&mfd6_iout>,
				  <&mfd3_iout_1>,
				  <&mfd9_iout_1>,
				  <&mfd10_iout_1>,
				  <&mfd8_iout>;

		sw-powr-sensors = <&mfd6_pin>, <&mfd8_pin>;
	};

	thermal-zones {
		fan-ctrl-v5 {
			compatible = "thermal-fan-ctrl-v5";
			thermal-sensors = <&switch_temp0>, <&switch_temp1>;

			trips {
				trip_0: trip-0 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <20>;
					duty-cycle = <40>;
				};
				trip_1: trip-1 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <25>;
					duty-cycle = <45>;
				};
				trip_2: trip-2 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <30>;
					duty-cycle = <50>;
				};
				trip_3: trip-3 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <35>;
					duty-cycle = <60>;
				};
				trip_4: trip-4 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <36>;
					duty-cycle = <61>;
				};
				trip_5: trip-5 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <37>;
					duty-cycle = <62>;
				};
				trip_6: trip-6 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <38>;
					duty-cycle = <63>;
				};
				trip_7: trip-7 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <39>;
					duty-cycle = <64>;
				};
				trip_8: trip-8 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <40>;
					duty-cycle = <65>;
				};
				trip_9: trip-9 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <41>;
					duty-cycle = <70>;
				};
				trip_10: trip-10 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <42>;
					duty-cycle = <75>;
				};
				trip_11: trip-11 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <43>;
					duty-cycle = <80>;
				};
				trip_12: trip-12 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <44>;
					duty-cycle = <85>;
				};
				trip_13: trip-13 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <45>;
					duty-cycle = <90>;
				};
				trip_14: trip-14 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <46>;
					duty-cycle = <92>;
				};
				trip_15: trip-15 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <47>;
					duty-cycle = <94>;
				};
				trip_16: trip-16 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <48>;
					duty-cycle = <96>;
				};
				trip_17: trip-17 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <49>;
					duty-cycle = <98>;
				};
				trip_18: trip-18 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <50>;
					duty-cycle = <100>;
				};
			};

			cooling-maps {
				map_0: map-0 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_0>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_1: map-1 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_1>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_2: map-2 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_2>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_3: map-3 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_3>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_4: map-4 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_4>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_5: map-5 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_5>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_6: map-6 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_6>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_7: map-7 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_7>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_8: map-8 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_8>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_9: map-9 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_9>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_10: map-10 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_10>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_11: map-11 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_11>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_12: map-12 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_12>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_13: map-13 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_13>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_14: map-14 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_14>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_15: map-15 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_15>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_16: map-16 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_16>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_17: map-17 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_17>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
				map_18: map-18 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_18>;
					cooling-device = <&fan1_1>, <&fan1_2>, <&fan1_3>, <&fan1_4>, <&fan2_1>, <&fan2_2>, <&fan2_3>, <&fan2_4>;
				};
			};
		};
	};
};
