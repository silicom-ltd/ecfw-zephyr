 *
 * DTS overlay file for MHO-150/MHO-180 Switch card.
 */
/ {
	smbus1: smbus1 {
		compatible = "microchip,xec-smbus";
		i2c = <&i2c_smb_3>;
		#address-cells = <1>;
		#size-cells = <0>;

		mfd3: mpq8788@31 {
			compatible = "mps,mpq8785";
			reg = <0x31>;

			mfd3_vin: 3v3_left_vin {
				compatible = "mps,mpq8785-vin";
				page = <0>;
				coefficients = <4 0 1>;
			};
			mfd3_vout: 3v3_left_vout {
				compatible = "mps,mpq8785-vout";
				page = <0>;
				coefficients = <512 0 0>;
			};
			mfd3_iout: 3v3_left_iout {
				compatible = "mps,mpq8785-iout";
				page = <0>;
				coefficients = <16 0 0>;
			};
			mfd3_temp: 3v3_left_temp {
				compatible = "mps,mpq8785-temp";
				page = <0>;
				coefficients = <1 0 0>;
			};
		};
		mfd3_1: mpq8787@31 {
			compatible = "mps,mpq8785";
			reg = <0x31>;

			mfd31_vin: 3v3_left_vin {
				compatible = "mps,mpq8785-vin";
				page = <0>;
				coefficients = <4 0 1>;
			};
			mfd31_vout: 3v3_left_vout {
				compatible = "mps,mpq8785-vout";
				page = <0>;
				coefficients = <512 0 0>;
			};
			mfd31_iout: 3v3_left_iout {
				compatible = "mps,mpq8785-iout";
				page = <0>;
				coefficients = <16 0 0>;
			};
			mfd31_temp: 3v3_left_temp {
				compatible = "mps,mpq8785-temp";
				page = <0>;
				coefficients = <1 0 0>;
			};
		};
		mfd4: mpq8788@32 {
			compatible = "mps,mpq8785";
			reg = <0x32>;

			mfd4_vin: 3v3_right_vin {
				compatible = "mps,mpq8785-vin";
				page = <0>;
				coefficients = <4 0 1>;
			};
			mfd4_vout: 3v3_right_vout {
				compatible = "mps,mpq8785-vout";
				page = <0>;
				coefficients = <512 0 0>;
			};
			mfd4_iout: 3v3_right_iout {
				compatible = "mps,mpq8785-iout";
				page = <0>;
				coefficients = <16 0 0>;
			};
			mfd4_temp: 3v3_right_temp {
				compatible = "mps,mpq8785-temp";
				page = <0>;
				coefficients = <1 0 0>;
			};
		};
		mfd5: mpq8790@30 {
			compatible = "mps,mpq8785";
			reg = <0x30>;

			mfd5_vin: vddh_vin {
				compatible = "mps,mpq8785-vin";
				page = <0>;
				coefficients = <4 0 1>;
			};
			mfd5_vout: vddh_vout {
				compatible = "mps,mpq8785-vout";
				page = <0>;
				coefficients = <512 0 0>;
			};
			mfd5_iout: vddh_iout {
				compatible = "mps,mpq8785-iout";
				page = <0>;
				coefficients = <16 0 0>;
			};
			mfd5_temp: vddh_temp {
				compatible = "mps,mpq8785-temp";
				page = <0>;
				coefficients = <1 0 0>;
			};
		};
		mfd6: crps@58 {
			compatible = "ocp,crps";
			reg = <0x58>;

			mfd6_temp_amb: psu1_ambient {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <141>;
			};
			mfd6_temp_hot: psu1_hot {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <142>;
			};
			mfd6_iout: psu1_iout {
				compatible = "ocp,crps-iout";
				page = <0>;
			};
			mfd6_pin: psu1_pin {
				compatible = "ocp,crps-power";
				page = <0>;
			};
		};
		mfd7: mp2928@20 {
			compatible = "mps,mp2928";
			reg = <0x20>;

			mfd7_temp: core_vdd_temp {
				compatible = "mps,mp2928-temp";
				page = <0>;
			};
			mfd7_r0_vout: core_vdd_vout {
				compatible = "mps,mp2928-vout";
				page = <0>;
			};
			mfd7_r1_vout: gop_vdd_vout {
				compatible = "mps,mp2928-vout";
				page = <1>;
			};
			mfd7_r2_vout: vdda_vout {
				compatible = "mps,mp2928-vout";
				page = <2>;
			};
			mfd7_r0_iout: core_vdd_iout {
				compatible = "mps,mp2928-iout";
				page = <0>;
			};
			mfd7_r1_iout: gop_vdd_iout {
				compatible = "mps,mp2928-iout";
				page = <1>;
			};
			mfd7_r2_iout: vdda_iout {
				compatible = "mps,mp2928-iout";
				page = <2>;
			};
		};
		mfd8: crps@59 {
			compatible = "ocp,crps";
			reg = <0x59>;

			mfd8_temp_amb: psu2_ambient {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <141>;
			};
			mfd8_temp_hot: psu2_hot {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <142>;
			};
			mfd8_iout: psu2_iout {
				compatible = "ocp,crps-iout";
				page = <0>;
			};
			mfd8_pin: psu2_pin {
				compatible = "ocp,crps-power";
				page = <0>;
			};
		};
	};

	zephyr,user {
		sw-die-temp-sensors = <&mfd3_temp>,
				      <&mfd4_temp>,
				      <&mfd5_temp>,
				      <&mfd6_temp_amb>,
				      <&mfd6_temp_hot>,
				      <&mfd7_temp>,
				      <&mfd8_temp_amb>,
				      <&mfd8_temp_hot>,
				      <&switch_maestro_temp>;

		sw-amb-temp-sensors = <&switch_temp0>, <&switch_temp1>;

		sw-volt-sensors = <&mfd3_vout>,
				  <&mfd4_vout>,
				  <&mfd5_vout>,
				  <&mfd7_r0_vout>,
				  <&mfd7_r1_vout>,
				  <&mfd7_r2_vout>;

		sw-curr-sensors = <&mfd3_iout>,
				  <&mfd4_iout>,
				  <&mfd5_iout>,
				  <&mfd6_iout>,
				  <&mfd7_r0_iout>,
				  <&mfd7_r1_iout>,
				  <&mfd7_r2_iout>,
				  <&mfd8_iout>;

		sw-powr-sensors = <&mfd6_pin>, <&mfd8_pin>;
	};

	fan1_1_cooling: fan1-1-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan1_1>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	fan1_2_cooling: fan1-2-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan1_2>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	fan1_3_cooling: fan1-3-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan1_3>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	fan1_4_cooling: fan1-4-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan1_4>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	fan2_1_cooling: fan2-1-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan2_1>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	fan2_2_cooling: fan2-2-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan2_2>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	fan2_3_cooling: fan2-3-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan2_3>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	fan2_4_cooling: fan2-4-cooling {
		compatible = "thermal-fan-ctrl-v5-cooling-device";
		#cooling-cells = <2>;
		fan-devices = <&fan2_4>;
		cooling-levels = <40 45 50 60 61 62 63 64 65 70 75 80 85 90 92 94 96 98 100>;
	};

	thermal-zones {
		fan-ctrl-v5 {
			compatible = "thermal-fan-ctrl-v5";
			thermal-sensors = <&switch_temp0>, <&switch_temp1>;

			trips {
				trip_0: trip-0 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <20>;
				};
				trip_1: trip-1 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <25>;
				};
				trip_2: trip-2 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <30>;
				};
				trip_3: trip-3 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <35>;
				};
				trip_4: trip-4 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <36>;
				};
				trip_5: trip-5 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <37>;
				};
				trip_6: trip-6 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <38>;
				};
				trip_7: trip-7 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <39>;
				};
				trip_8: trip-8 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <40>;
				};
				trip_9: trip-9 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <41>;
				};
				trip_10: trip-10 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <42>;
				};
				trip_11: trip-11 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <43>;
				};
				trip_12: trip-12 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <44>;
				};
				trip_13: trip-13 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <45>;
				};
				trip_14: trip-14 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <46>;
				};
				trip_15: trip-15 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <47>;
				};
				trip_16: trip-16 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <48>;
				};
				trip_17: trip-17 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <49>;
				};
				trip_18: trip-18 {
					compatible = "thermal-fan-ctrl-v5-trip";
					temperature = <50>;
				};
			};

			cooling-maps {
				map_0: map-0 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_0>;
					cooling-device = <&fan1_1_cooling 0 0>, <&fan1_2_cooling 0 0>, <&fan1_3_cooling 0 0>, <&fan1_4_cooling 0 0>, <&fan2_1_cooling 0 0>, <&fan2_2_cooling 0 0>, <&fan2_3_cooling 0 0>, <&fan2_4_cooling 0 0>;
				};
				map_1: map-1 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_1>;
					cooling-device = <&fan1_1_cooling 0 1>, <&fan1_2_cooling 0 1>, <&fan1_3_cooling 0 1>, <&fan1_4_cooling 0 1>, <&fan2_1_cooling 0 1>, <&fan2_2_cooling 0 1>, <&fan2_3_cooling 0 1>, <&fan2_4_cooling 0 1>;
				};
				map_2: map-2 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_2>;
					cooling-device = <&fan1_1_cooling 1 2>, <&fan1_2_cooling 1 2>, <&fan1_3_cooling 1 2>, <&fan1_4_cooling 1 2>, <&fan2_1_cooling 1 2>, <&fan2_2_cooling 1 2>, <&fan2_3_cooling 1 2>, <&fan2_4_cooling 1 2>;
				};
				map_3: map-3 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_3>;
					cooling-device = <&fan1_1_cooling 2 3>, <&fan1_2_cooling 2 3>, <&fan1_3_cooling 2 3>, <&fan1_4_cooling 2 3>, <&fan2_1_cooling 2 3>, <&fan2_2_cooling 2 3>, <&fan2_3_cooling 2 3>, <&fan2_4_cooling 2 3>;
				};
				map_4: map-4 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_4>;
					cooling-device = <&fan1_1_cooling 3 4>, <&fan1_2_cooling 3 4>, <&fan1_3_cooling 3 4>, <&fan1_4_cooling 3 4>, <&fan2_1_cooling 3 4>, <&fan2_2_cooling 3 4>, <&fan2_3_cooling 3 4>, <&fan2_4_cooling 3 4>;
				};
				map_5: map-5 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_5>;
					cooling-device = <&fan1_1_cooling 4 5>, <&fan1_2_cooling 4 5>, <&fan1_3_cooling 4 5>, <&fan1_4_cooling 4 5>, <&fan2_1_cooling 4 5>, <&fan2_2_cooling 4 5>, <&fan2_3_cooling 4 5>, <&fan2_4_cooling 4 5>;
				};
				map_6: map-6 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_6>;
					cooling-device = <&fan1_1_cooling 5 6>, <&fan1_2_cooling 5 6>, <&fan1_3_cooling 5 6>, <&fan1_4_cooling 5 6>, <&fan2_1_cooling 5 6>, <&fan2_2_cooling 5 6>, <&fan2_3_cooling 5 6>, <&fan2_4_cooling 5 6>;
				};
				map_7: map-7 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_7>;
					cooling-device = <&fan1_1_cooling 6 7>, <&fan1_2_cooling 6 7>, <&fan1_3_cooling 6 7>, <&fan1_4_cooling 6 7>, <&fan2_1_cooling 6 7>, <&fan2_2_cooling 6 7>, <&fan2_3_cooling 6 7>, <&fan2_4_cooling 6 7>;
				};
				map_8: map-8 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_8>;
					cooling-device = <&fan1_1_cooling 7 8>, <&fan1_2_cooling 7 8>, <&fan1_3_cooling 7 8>, <&fan1_4_cooling 7 8>, <&fan2_1_cooling 7 8>, <&fan2_2_cooling 7 8>, <&fan2_3_cooling 7 8>, <&fan2_4_cooling 7 8>;
				};
				map_9: map-9 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_9>;
					cooling-device = <&fan1_1_cooling 8 9>, <&fan1_2_cooling 8 9>, <&fan1_3_cooling 8 9>, <&fan1_4_cooling 8 9>, <&fan2_1_cooling 8 9>, <&fan2_2_cooling 8 9>, <&fan2_3_cooling 8 9>, <&fan2_4_cooling 8 9>;
				};
				map_10: map-10 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_10>;
					cooling-device = <&fan1_1_cooling 9 10>, <&fan1_2_cooling 9 10>, <&fan1_3_cooling 9 10>, <&fan1_4_cooling 9 10>, <&fan2_1_cooling 9 10>, <&fan2_2_cooling 9 10>, <&fan2_3_cooling 9 10>, <&fan2_4_cooling 9 10>;
				};
				map_11: map-11 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_11>;
					cooling-device = <&fan1_1_cooling 10 11>, <&fan1_2_cooling 10 11>, <&fan1_3_cooling 10 11>, <&fan1_4_cooling 10 11>, <&fan2_1_cooling 10 11>, <&fan2_2_cooling 10 11>, <&fan2_3_cooling 10 11>, <&fan2_4_cooling 10 11>;
				};
				map_12: map-12 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_12>;
					cooling-device = <&fan1_1_cooling 11 12>, <&fan1_2_cooling 11 12>, <&fan1_3_cooling 11 12>, <&fan1_4_cooling 11 12>, <&fan2_1_cooling 11 12>, <&fan2_2_cooling 11 12>, <&fan2_3_cooling 11 12>, <&fan2_4_cooling 11 12>;
				};
				map_13: map-13 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_13>;
					cooling-device = <&fan1_1_cooling 12 13>, <&fan1_2_cooling 12 13>, <&fan1_3_cooling 12 13>, <&fan1_4_cooling 12 13>, <&fan2_1_cooling 12 13>, <&fan2_2_cooling 12 13>, <&fan2_3_cooling 12 13>, <&fan2_4_cooling 12 13>;
				};
				map_14: map-14 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_14>;
					cooling-device = <&fan1_1_cooling 13 14>, <&fan1_2_cooling 13 14>, <&fan1_3_cooling 13 14>, <&fan1_4_cooling 13 14>, <&fan2_1_cooling 13 14>, <&fan2_2_cooling 13 14>, <&fan2_3_cooling 13 14>, <&fan2_4_cooling 13 14>;
				};
				map_15: map-15 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_15>;
					cooling-device = <&fan1_1_cooling 14 15>, <&fan1_2_cooling 14 15>, <&fan1_3_cooling 14 15>, <&fan1_4_cooling 14 15>, <&fan2_1_cooling 14 15>, <&fan2_2_cooling 14 15>, <&fan2_3_cooling 14 15>, <&fan2_4_cooling 14 15>;
				};
				map_16: map-16 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_16>;
					cooling-device = <&fan1_1_cooling 15 16>, <&fan1_2_cooling 15 16>, <&fan1_3_cooling 15 16>, <&fan1_4_cooling 15 16>, <&fan2_1_cooling 15 16>, <&fan2_2_cooling 15 16>, <&fan2_3_cooling 15 16>, <&fan2_4_cooling 15 16>;
				};
				map_17: map-17 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_17>;
					cooling-device = <&fan1_1_cooling 16 17>, <&fan1_2_cooling 16 17>, <&fan1_3_cooling 16 17>, <&fan1_4_cooling 16 17>, <&fan2_1_cooling 16 17>, <&fan2_2_cooling 16 17>, <&fan2_3_cooling 16 17>, <&fan2_4_cooling 16 17>;
				};
				map_18: map-18 {
					compatible = "thermal-fan-ctrl-v5-cooling-map";
					trip = <&trip_18>;
					cooling-device = <&fan1_1_cooling 17 18>, <&fan1_2_cooling 17 18>, <&fan1_3_cooling 17 18>, <&fan1_4_cooling 17 18>, <&fan2_1_cooling 17 18>, <&fan2_2_cooling 17 18>, <&fan2_3_cooling 17 18>, <&fan2_4_cooling 17 18>;
				};
			};
		};
	};

};
