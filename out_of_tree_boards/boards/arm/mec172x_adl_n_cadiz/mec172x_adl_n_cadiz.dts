/dts-v1/;

#include <microchip/mec172xnlj.dtsi>
#include <microchip/mec172x/mec172xnsz-pinctrl.dtsi>
#include <microchip/mec172x/mec172xnlj-pinctrl.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
	model = "Silicom ADL-N CADIZ MEC172X EC";
	compatible = "microchip,mec172x_adl_n_cadiz", "microchip,mec172xnlj";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart1;
		zephyr,shell-uart = &uart1;
	};

	aliases {
		i2c0 = &i2c_smb_0;
		i2c-0 = &i2c_smb_0;
		i2c3 = &i2c_smb_1;
		peci = &peci0;
		led-1 = &pwmmcled0;
		gpioled0 = &gpioled0;
		gpioled1 = &gpioled1;
		gpioled2 = &gpioled2;
		gpioled3 = &gpioled3;
		gpioled4 = &gpioled4;
		eeprom0 = &eeprom;
	};

	cputemp: cpu-temp {
		compatible = "x86-peci-temp";
		peci-dev = <&peci0>;
		status = "disabled";
	};

	gpio_keys {
		compatible = "gpio-keys";

		/* make a DT entry for the ESPI_RESET# input */
		espi_rst_maf: espi-rst {
			gpios = <&gpio_040_076 16 GPIO_ACTIVE_LOW>;
			label = "ESPI_RST_MAF";
		};
	};
  

	/* Front panel GPIO LEDs — each position shares a light pipe with a PWM RGB LED */

	/* Amber: pwr, top-left (GPIO156) */
	gpioled0: gpioled0 {
		compatible = "gpio-leds";
		gpio_led0: led-0 {
			gpios = <&gpio_140_176 14 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Amber: 'A', bottom-left (GPIO153) */
	gpioled1: gpioled1 {
		compatible = "gpio-leds";
		gpio_led1: led-1 {
			gpios = <&gpio_140_176 11 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Amber: 'B', top-right (GPIO157) */
	gpioled2: gpioled2 {
		compatible = "gpio-leds";
		gpio_led2: led-2 {
			gpios = <&gpio_140_176 15 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Amber: mgmt, bottom-right (GPIO035) */
	gpioled3: gpioled3 {
		compatible = "gpio-leds";
		gpio_led3: led-3 {
			gpios = <&gpio_000_036 29 GPIO_ACTIVE_HIGH>;
		};
	};

	/* Blue: mgmt, bottom-right (GPIO053) — active-low; no full RGB PWM available */
	gpioled4: gpioled4 {
		compatible = "gpio-leds";
		gpio_led4: led-4 {
			gpios = <&gpio_040_076 11 GPIO_ACTIVE_LOW>;
		};
	};

	/* RGB LEDs */
	pwm_mc_leds: pwm_mc_leds {
		compatible = "pwm-leds-multicolor";

		/* RGB: pwr, top-left */
		pwmmcled0: topleft {
			pwms = <&pwm4 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
			       <&pwm5 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
			       <&pwm6 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>;

			color-mapping = <LED_COLOR_ID_RED>,
					<LED_COLOR_ID_GREEN>,
					<LED_COLOR_ID_BLUE>;
		};
		/* RGB: 'A', bottom-left */
		pwmmcled1: bottomleft {
			pwms = <&pwm2 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
		       	       <&pwm9  0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
		       	       <&pwm3  0 PWM_MSEC(5) PWM_POLARITY_INVERTED>;

			color-mapping = <LED_COLOR_ID_RED>,
					<LED_COLOR_ID_GREEN>,
					<LED_COLOR_ID_BLUE>;
		};
		/* RGB: 'B', top-right */
		pwmmcled2: topright {
			pwms = <&pwm10 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
			       <&pwm7 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
			       <&pwm8 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>;

			color-mapping = <LED_COLOR_ID_RED>,
					<LED_COLOR_ID_GREEN>,
					<LED_COLOR_ID_BLUE>;
		};
	};

	voltage0: voltage12v {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 0>;
		io-channel-names = "12V";
		output-ohms = <3320>;
		full-ohms = <(10000+3320)>; 
	};
	voltage1: voltage5v {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 1>;
		io-channel-names = "5V";
		output-ohms = <1000>;
		full-ohms = <(1000+1000)>;
	};
	voltage2: voltage3v3 {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 2>;
		io-channel-names = "3.3V";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	voltage3: voltage0v85x710 {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 3>;
		io-channel-names = "0.85V_X710";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	voltage4: voltage1v8_proc {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 5>;
		io-channel-names = "1.85V_PROC";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	voltage5: voltage1v8 {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 9>;
		io-channel-names = "1.8V";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	current0: expbpwrmon {
		compatible = "current-sense-amplifier";
		status = "okay";
		io-channels = <&adc0 10>;
		io-channel-names = "EXPB_PWRMON";
		sense-resistor-micro-ohms = <3>;
		sense-gain-mult = <50>;
	};
	voltage6: voltagevccinaux {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 11>;
		io-channel-names = "VCCinAux";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	voltage7: voltage1v065vdd2 {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 12>;
		io-channel-names = "1.065V_VDD2";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	current1: voutpwrmon {
		compatible = "current-sense-amplifier";
		status = "okay";
		io-channels = <&adc0 13>;
		io-channel-names = "VOUT_PWRMON";
		sense-resistor-micro-ohms = <1>;
		sense-gain-mult = <50>;
	};
	voltage8: voltage0v5vddq {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 14>;
		io-channel-names = "0.5V_VDDq";
		output-ohms = <1>;
		full-ohms = <1>;
	};

	smbus1: smbus1 {
		compatible = "microchip,xec-smbus";
		i2c = <&i2c_smb_3>;
		#address-cells = <1>;
		#size-cells = <0>;

		fanctrl0: fanctrl@52 {
			compatible = "maxim,max31785";
			reg = <0x52>;
			reset-gpios = <&gpio_200_236 26 GPIO_ACTIVE_HIGH>;
			ctrl-gpios = <&gpio_200_236 19 GPIO_ACTIVE_HIGH>;
			fans {
				compatible = "maxim,max31785-fan";

				max31785_fan0: fan0 {
					page = <0>;
					mode = "FAN_AUTO_PWM";
					ppr = <2>;
					fan-speeds = <35 35 35 45 60 75 90 100>;
					fan-temps =  <10 20 32 35 38 40 43 45>;
					locked-rotor-en = <0>;
					initial-setting = <25>;
				};
				max31785_fan1: fan1 {
					page = <1>;
					mode = "FAN_AUTO_PWM";
					ppr = <2>;
					fan-speeds = <35 35 35 45 60 75 90 100>;
					fan-temps =  <10 20 32 35 38 40 43 45>;
					locked-rotor-en = <0>;
					initial-setting = <25>;
				};
				max31785_fan2: fan2 {
					page = <2>;
					mode = "FAN_AUTO_PWM";
					ppr = <2>;
					fan-speeds = <35 35 35 45 60 75 90 100>;
					fan-temps =  <10 20 32 35 38 40 43 45>;
					locked-rotor-en = <0>;
					initial-setting = <25>;
				};
				max31785_fan3: fan3 {
					page = <3>;
					mode = "FAN_AUTO_PWM";
					ppr = <2>;
					fan-speeds = <35 35 35 45 60 75 90 100>;
					fan-temps =  <10 20 32 35 38 40 43 45>;
					locked-rotor-en = <0>;
					initial-setting = <10>;
				};
				max31785_fan4: fan4 {
					page = <4>;
					mode = "FAN_AUTO_PWM";
					ppr = <2>;
					fan-speeds = <35 35 35 45 60 75 90 100>;
					fan-temps =  <10 20 32 35 38 40 43 45>;
					locked-rotor-en = <0>;
					initial-setting = <10>;
				};
				max31785_fan5: fan5 {
					page = <5>;
					mode = "FAN_AUTO_PWM";
					ppr = <2>;
					fan-speeds = <35 35 35 45 60 75 90 100>;
					fan-temps =  <10 20 32 35 38 40 43 45>;
					locked-rotor-en = <0>;
					initial-setting = <10>;
				};
			};
			sensors {
				compatible = "maxim,max31785-dts";

				max31785_dts0: dts0 {
					fans = <&max31785_fan0 &max31785_fan1 &max31785_fan2
						&max31785_fan3 &max31785_fan4 &max31785_fan5>;
				};
				max31785_dts1: dts1 {
				};
				max31785_dts2: dts2 {
				};
				max31785_dts3: dts3 {
				};
				max31785_dts4: dts4 {
				};
				max31785_dts5: dts5 {
				};
				max31785_die: die {
				};
				max31785_i2c0: i2c0 {
				};
				max31785_i2c1: i2c1 {
				};
			};
		};
	};

	smbus2: smbus2 {
		compatible = "microchip,xec-smbus";
		i2c = <&i2c_smb_0>;
		#address-cells = <1>;
		#size-cells = <0>;

		mp2964: mp2964@20 {
			status = "disabled";
			compatible = "mps,mp2964";
			reg = <0x20>;

			mp2964_vout_0: vccin {
				compatible = "mps,mp2964-vout";
				status = "disabled";
				page = <0>;
			};
			mp2964_vout_1: vccgt {
				compatible = "mps,mp2964-vout";
				status = "disabled";
				page = <1>;
			};
		};
	};

	zephyr,user {
		pinctrl-0 = <&gpio101 &gpio102 &gpio172 &gpio173 &gpio_uc_2>;
		pinctrl-names = "default";
	};
};

&gpio_200_236 {
	fan-ctrl-rst {
		gpio-hog;
		gpios = <26 GPIO_ACTIVE_HIGH>;
		output-high;
	};
	fan-ctrl-ctrl {
		gpio-hog;
		gpios = <19 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};

&cpu0 {
	clock-frequency = <96000000>;
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_tx_gpio104 &uart0_rx_gpio105
		     &uart0_cts_n_gpio143 &uart0_rts_n_gpio144>;
	pinctrl-names = "default";
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_tx_gpio170 &uart1_rx_gpio171>;
	pinctrl-names = "default";
};

&eeprom {
	status = "okay";

	pinctrl-0 = <&eeprom_cs_gpio116
		     &eeprom_clk_gpio117
		     &eeprom_mosi_gpio074
		     &eeprom_miso_gpio075>;
	pinctrl-names = "default";
};

&i2c_smb_0 {
	status = "okay";
	port_sel = <0>;

	pinctrl-0 = <&i2c00_sda_gpio003
		     &i2c00_scl_gpio004>;
	pinctrl-names = "default";

};

&i2c_smb_1 {
	status = "okay";
	port_sel = <3>;

	pinctrl-0 = <&i2c03_sda_gpio007
                     &i2c03_scl_gpio010>;
	pinctrl-names = "default";

	spd: dev@54 {
		compatible = "atmel,at24";
		status = "disabled";
		reg = <0x54>;
		size = <256>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};
};

&i2c03_sda_gpio007 {
	drive-open-drain;
	output-high;
};
&i2c03_scl_gpio010 {
	drive-open-drain;
	output-high;
};

&i2c_smb_4 {
	status = "okay";
	port_sel = <12>;
	
	pinctrl-0 = <&i2c12_sda_gpio026 &i2c12_scl_gpio027>;
	pinctrl-names = "default";

	lm75: lm75@4b {
		compatible = "zephyr,i2c-target-lm75";
		reg = <0x4B>;
		target-sensor = <&cputemp>;
		status = "disabled";
	};
};

&i2c12_sda_gpio026 {
	drive-open-drain;
	output-high;
};
&i2c12_scl_gpio027 {
	drive-open-drain;
	output-high;
};

&i2c_smb_3 {
	status = "okay";
	port_sel = <8>;

	pinctrl-0 = <&i2c08_sda_gpio231 &i2c08_scl_gpio230>;
	pinctrl-names = "default";

	fru: dev@56 {
		compatible = "atmel,at24";
		status = "disabled";
		reg = <0x56>;
		size = <512>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};
};

&i2c_smb_2 {
	status = "okay";
	port_sel = <5>;

	//pinctrl-0 = <&i2c11_sda_alt_gpio005 &i2c11_scl_alt_gpio006>;
	pinctrl-0 = <&i2c05_sda_gpio141 &i2c05_scl_gpio142>;
	pinctrl-names = "default";

	lom_mgmt: lom_mgmt@30 {
		compatible = "i2c-target-lom-mgmt";
		status = "okay";
		reg = <0x30>;
	};
};

&i2c03_sda_gpio007 {
	drive-open-drain;
	output-high;
};

&i2c03_scl_gpio010 {
	drive-open-drain;
	output-high;
};

&i2c05_sda_gpio141 {
	drive-open-drain;
	output-high;
};

&i2c05_scl_gpio142 {
	drive-open-drain;
	output-high;
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc00_gpio200 &adc01_gpio201
		     &adc02_gpio202 &adc03_gpio203
		     &adc04_gpio204 &adc05_gpio205
		     &adc06_gpio206
		     &adc09_gpio211 &adc10_gpio212
		     &adc11_gpio213 &adc12_gpio214
		     &adc13_gpio215 &adc14_gpio216
		     &adc15_gpio217>;
	pinctrl-names = "default";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@3 {
		reg = <3>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@4 {
		reg = <4>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@5 {
		reg = <5>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@6 {
		reg = <6>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@9 {
		reg = <9>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@a {
		reg = <10>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@b {
		reg = <11>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@c {
		reg = <12>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@d {
		reg = <13>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@e {
		reg = <14>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

	channel@f {
		reg = <15>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,resolution = <10>;
		zephyr,vref-mv = <3300>;
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
	};

};

&pwm2 {
	status = "okay";
	pinctrl-0 = <&pwm2_alt_gpio045>;
	pinctrl-names = "default";
};

&pwm3 {
	status = "okay";
	pinctrl-0 = <&pwm3_alt_gpio047>;
	pinctrl-names = "default";
};

&pwm4 {
	status = "okay";
	pinctrl-0 = <&pwm4_alt_gpio001>;
	pinctrl-names = "default";
};

&pwm5 {
	status = "okay";
	pinctrl-0 = <&pwm5_gpio002>;
	pinctrl-names = "default";
};

&pwm6 {
	status = "okay";
	pinctrl-0 = <&pwm6_gpio014>;
	pinctrl-names = "default";
};

&pwm7 {
	status = "okay";
	pinctrl-0 = <&pwm7_gpio015>;
	pinctrl-names = "default";
};

&pwm8 {
	status = "okay";
	pinctrl-0 = <&pwm8_alt_gpio175>;
	pinctrl-names = "default";
};

&pwm9 {
	status = "okay";
	pinctrl-0 = <&pwm9_gpio133>;
	pinctrl-names = "default";
};

&pwm10 {
	status = "okay";
	pinctrl-0 = <&pwm10_gpio134>;
	pinctrl-names = "default";
};

/* Initialize ECIA. Does not initialize child devices */
&ecia {
	status = "okay";
};

/* Enable aggregated GIRQ24 and GIRQ25 for eSPI virtual wires interrupts */
&girq24 {
	status = "okay";
};

&girq25 {
	status = "okay";
};

&rtimer {
	status = "okay";
};

&pcr {
	status = "okay";
};

&espi0 {
	status = "okay";
	pinctrl-0 = < &espi_reset_n_gpio061 &espi_cs_n_gpio066
		      &espi_alert_n_gpio063 &espi_clk_gpio065
		      &espi_io0_gpio070 &espi_io1_gpio071
		      &espi_io2_gpio072 &espi_io3_gpio073 >;
	pinctrl-names = "default";
};

&spi0 {
	status = "okay";
	pinctrl-0 = < &pvt_cs_n_gpio124
		      &pvt_clk_gpio125
		      &pvt_io0_gpio121
		      &pvt_io1_gpio122
		      &pvt_io2_gpio123
		      &pvt_io3_gpio126 >;

	pinctrl-names = "default";
};

&acpi_ec0 {
	status = "okay";
};

&acpi_ec1 {
	status = "okay";
};

&emi1 {
	status = "okay";
};

&peci0 {
	status = "okay";
	pinctrl-0 = < &peci_dat_gpio042 &vref_vtt_gpio044 >;
	pinctrl-names = "default";
};

&pinctrl {
	gpio101: gpio101 {
		pinmux = < MCHP_XEC_PINMUX(0101, MCHP_AF0) >;
		bias-disable;
	};
	gpio102: gpio102 {
		pinmux = < MCHP_XEC_PINMUX(0102, MCHP_AF0) >;
		bias-disable;
	};
	gpio172: gpio172 {
		pinmux = < MCHP_XEC_PINMUX(0172, MCHP_AF0) >;
		bias-disable;
	};
	gpio173: gpio173 {
		pinmux = < MCHP_XEC_PINMUX(0173, MCHP_AF0) >;
		bias-disable;
	};
	gpio_uc_0: gpio112 {
		pinmux = < MCHP_XEC_PINMUX(112, MCHP_GPIO) >;
		bias-pull-down;
	};
	gpio_uc_1: gpio113 {
		pinmux = < MCHP_XEC_PINMUX(113, MCHP_GPIO) >;
		bias-pull-down;
	};
	gpio_uc_2: gpio025 {
		pinmux = < MCHP_XEC_PINMUX(025, MCHP_GPIO) >;
		bias-pull-down;
	};
};

&wdog {
	status = "okay";
};	
