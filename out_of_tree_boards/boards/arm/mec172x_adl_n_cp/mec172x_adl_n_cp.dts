//	compatible = "microchip,xec-bbled";
//	status = "okay";
//	pinctrl-0 = <&led0_gpio156>;
//	pinctrl-names = "default";
//};

//&bbled1 {
//	compatible = "microchip,xec-bbled";
//	status = "okay";
//	pinctrl-0 = <&led1_gpio157>;
//	pinctrl-names = "default";
//};

//&bbled2 {
//	compatible = "microchip,xec-bbled";
//	status = "okay";
//	pinctrl-0 = <&led2_gpio153>;
//	pinctrl-names = "default";
//};

&cpu0 {
	clock-frequency = <96000000>;
	status = "okay";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart0_tx_gpio104 &uart0_rx_gpio105
		     &uart0_cts_n_gpio143 &uart0_rts_n_gpio144>;
	pinctrl-names = "default";
};

&uart1 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart1_tx_gpio170 &uart1_rx_gpio171>;
	pinctrl-names = "default";
};

&eeprom {
	status = "okay";

	pinctrl-0 = <&eeprom_cs_gpio116
		     &eeprom_clk_gpio117
		     &eeprom_mosi_gpio074
		     &eeprom_miso_gpio075>;
	pinctrl-names = "default";
};

&i2c_smb_0 {
	status = "okay";
	port_sel = <0>;

	pinctrl-0 = <&i2c00_sda_gpio003
		     &i2c00_scl_gpio004>;
	pinctrl-names = "default";

	vr: vr@20 {
		compatible = "vnd,i2c-device";
		status = "okay";
		reg = <0x20>;
	};

	sw_regulator0: swr@21 {
		compatible = "vnd,i2c-device";
		status = "okay";
		reg = <0x21>;
	};

};

&i2c_smb_1 {
	status = "okay";
	port_sel = <3>;

	pinctrl-0 = <&i2c03_sda_gpio007
                     &i2c03_scl_gpio010>;
	pinctrl-names = "default";

	fru: dev@56 {
		compatible = "atmel,at24";
		status = "okay";
		reg = <0x56>;
		size = <512>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};

	spd: dev@54 {
		compatible = "atmel,at24";
		status = "disabled";
		reg = <0x54>;
		size = <256>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};
};

&i2c_smb_2 {
	status = "ok";
	port_sel = <5>;
	
	pinctrl-0 = <&i2c05_sda_gpio141 &i2c05_scl_gpio142>;
	pinctrl-names = "default";

	lom_mgmt: lom_mgmt@30 {
		compatible = "i2c-target-lom-mgmt";
		status = "okay";
		reg = <0x30>;
		//size = <2048>;
	};
};

&i2c_smb_3 {
	status = "okay";
	port_sel = <8>;

	pinctrl-0 = <&i2c08_sda_gpio231 &i2c08_scl_gpio230>;
	pinctrl-names = "default";

	mfd1: dev@4d {
		compatible = "microchip,emc230x";
		status = "okay";
		reg = <0x4d>;

		fanctrl1: fancontroller {
			compatible = "microchip,emc230x-pwm";
			status = "okay";
			#pwm-cells = <2>;

			fan1_1: FAN1 {
				status = "okay";
				pwms = <&fanctrl1 0 26000>;
				tach = <&fan_speed1>;
				edges = <5>;
				initial = <50>;
			};
			fan1_2: FAN2 {
				status = "okay";
				pwms = <&fanctrl1 1 26000>;
				tach = <&fan_speed2>;
				edges = <5>;
				initial = <50>;
			};
			fan1_3: FAN3 {
				status = "okay";
				pwms = <&fanctrl1 2 26000>;
				tach = <&fan_speed3>;
				edges = <5>;
				initial = <50>;
			};
			fan1_4: FAN4 {
				status = "okay";
				pwms = <&fanctrl1 3 26000>;
				tach = <&fan_speed4>;
				edges = <5>;
				initial = <50>;
			};
		};
		fan_speed1: fanspeed1 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <0>;
		};
		fan_speed2: fanspeed2 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <1>;
		};
		fan_speed3: fanspeed3 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <2>;
		};
		fan_speed4: fanspeed4 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <3>;
		};
	};

	mfd2: dev@2f {
		compatible = "microchip,emc230x";
		status = "okay";
		reg = <0x2f>;

		fanctrl2: fancontroller {
			compatible = "microchip,emc230x-pwm";
			status = "okay";
			#pwm-cells = <2>;

			fan2_1: FAN1 {
				pwms = <&fanctrl2 0 26000>;
				tach = <&fan_speed5>;
				edges = <5>;
				initial = <50>;
			};
			fan2_2: FAN2 {
				pwms = <&fanctrl2 1 26000>;
				tach = <&fan_speed6>;
				edges = <5>;
				initial = <50>;
			};
			fan2_3: FAN3 {
				pwms = <&fanctrl2 2 26000>;
				tach = <&fan_speed7>;
				edges = <5>;
				initial = <50>;
			};
			fan2_4: FAN4 {
				pwms = <&fanctrl2 3 26000>;
				tach = <&fan_speed8>;
				edges = <5>;
				initial = <50>;
			};
		};
		fan_speed5: fanspeed5 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <0>;
		};
		fan_speed6: fanspeed6 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <1>;
		};
		fan_speed7: fanspeed7 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <2>;
		};
		fan_speed8: fanspeed8 {
			compatible = "microchip,emc230x-fan-speed";
			status = "okay";
			channel = <3>;
		};
	};

	fancage1: dev@54 {
		compatible = "atmel,at24";
		status = "okay";
		reg = <0x54>;
		size = <256>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};

	fancage2: dev@55 {
		compatible = "atmel,at24";
		status = "okay";
		reg = <0x55>;
		size = <256>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};

	fancage3: dev@56 {
		compatible = "atmel,at24";
		status = "okay";
		reg = <0x56>;
		size = <256>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};

	fancage4: dev@57 {
		compatible = "atmel,at24";
		status = "okay";
		reg = <0x57>;
		size = <256>;
		address-width = <8>;
		timeout = <25>;
		pagesize = <16>;
	};

	switch_temp0: dev@48 {
		compatible = "lm75";
		status = "okay";
		reg = <0x48>;
	};

	switch_temp1: dev@49 {
		compatible = "lm75";
		status = "okay";
		reg = <0x49>;
	};

};

&i2c_smb_4 {
	status = "okay";
	port_sel = <11>;

	pinctrl-0 = <&i2c11_sda_alt_gpio005 &i2c11_scl_alt_gpio006>;
	pinctrl-names = "default";
};

&i2c03_sda_gpio007 {
	drive-open-drain;
	output-high;
};

&i2c03_scl_gpio010 {
	drive-open-drain;
	output-high;
};

&i2c05_sda_gpio141 {
	drive-open-drain;
	output-high;
};

&i2c05_scl_gpio142 {
	drive-open-drain;
	output-high;
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&adc00_gpio200 &adc01_gpio201
		     &adc02_gpio202 &adc03_gpio203
		     &adc04_gpio204 &adc05_gpio205
		     &adc06_gpio206
		     &adc09_gpio211 &adc10_gpio212
		     &adc11_gpio213 &adc12_gpio214
		     &adc13_gpio215 &adc14_gpio216
		     &adc15_gpio217>;
	pinctrl-names = "default";

	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
