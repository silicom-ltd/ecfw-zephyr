/dts-v1/;

#include <microchip/mec172xnlj.dtsi>
#include <microchip/mec172x/mec172xnsz-pinctrl.dtsi>
#include <microchip/mec172x/mec172xnlj-pinctrl.dtsi>
#include <zephyr/dt-bindings/pwm/pwm.h>
#include <zephyr/dt-bindings/led/led.h>

/ {
	model = "Silicom ADL-N MEC172X Checkpoint EC";
	compatible = "microchip,mec172x_adl_n_cp", "microchip,mec172xnlj";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,console = &uart1;
	};

	aliases {
		i2c0 = &i2c_smb_0;
		i2c-0 = &i2c_smb_0;
		i2c3 = &i2c_smb_1;
		i2c11 = &i2c_smb_2;
		peci-0 = &peci0;
		led0 = &pwmmcled1;
		led1 = &pwmmcled2;
		eeprom0 = &eeprom;
		fan0 = &fan1_1;
		fan1 = &fan1_2;
		fan2 = &fan1_3;
		fan3 = &fan1_4;
		fan4 = &fan2_1;
		fan5 = &fan2_2;
		fan6 = &fan2_3;
		fan7 = &fan2_4;
		gpioled0 = &amber_mid;
		gpioled1 = &amber_bot;
		gpioled2 = &pwr_led_green;
		gpioled3 = &front_location;
	};

	gpio_keys {
		compatible = "gpio-keys";

		/* make a DT entry for the ESPI_RESET# input */
		espi_rst_maf: espi-rst {
			gpios = <&gpio_040_076 16 GPIO_ACTIVE_LOW>;
			label = "ESPI_RST_MAF";
		};
	};

	pwm_mc_leds: pwm_mc_leds {
		compatible = "pwm-leds-multicolor";

		pwmmcled1: pwmmcled-1 {
			pwms = <&pwm10 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
		       	       <&pwm7  0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
		       	       <&pwm8  0 PWM_MSEC(5) PWM_POLARITY_INVERTED>;

			color-mapping = <LED_COLOR_ID_RED>,
					<LED_COLOR_ID_GREEN>,
					<LED_COLOR_ID_BLUE>;
		};
		pwmmcled2: pwmmcled-2 {
			pwms = <&pwm2 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
			       <&pwm9 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>,
			       <&pwm3 0 PWM_MSEC(5) PWM_POLARITY_INVERTED>;

			color-mapping = <LED_COLOR_ID_RED>,
					<LED_COLOR_ID_GREEN>,
					<LED_COLOR_ID_BLUE>;
		};
	};

	amber_mid: led_0 {
		compatible = "gpio-leds";
		/* GPIO 157 */
		led0 {
			gpios = <&gpio_140_176 15 GPIO_ACTIVE_HIGH>;
		};
	};
	amber_bot: led_1 {
		compatible = "gpio-leds";
		/* GPIO 153 */
		led1 {
			gpios = <&gpio_140_176 11 GPIO_ACTIVE_HIGH>;
		};
	};
	fan1led: led_2 {
		compatible = "gpio-leds";
		/* GPIO 232 */
		led2 {
			gpios = <&gpio_200_236 26 GPIO_ACTIVE_LOW>;
		};
	};
	fan2led: led_3 {
		compatible = "gpio-leds";
		/* GPIO 222 */
		led3 {	
			gpios = <&gpio_200_236 18 GPIO_ACTIVE_LOW>;
		};
	};
	fan3led: led_4 {
		compatible = "gpio-leds";
		/* GPIO 1 */
		led4 {
			gpios = <&gpio_000_036 1 GPIO_ACTIVE_LOW>;
		};
	};
	fan4led: led_5 {
		compatible = "gpio-leds";
		/* GPIO 244 */
		led5 {
			gpios = <&gpio_240_276 4 GPIO_ACTIVE_LOW>;
		};
	};
	pwr_led_green: led_6 {
		compatible = "gpio-leds";
		/* GPIO 115 */
		led6 {
			gpios = <&gpio_100_136 13 GPIO_ACTIVE_LOW>;
		};
	};
	fan_fail: led_7 {
		compatible = "gpio-leds";
		/* GPIO 112 */
		led7 {
			gpios = <&gpio_100_136 10 GPIO_ACTIVE_LOW>;
		};
	};
	front_location: led_8 {
		compatible = "gpio-leds";
		/* GPIO 131 */
		led8: front_location {
			gpios = <&gpio_100_136 25 GPIO_ACTIVE_LOW>;
		};
	};
//	alert: led_9 {
//		compatible = "gpio-leds";
//		/* GPIO 174 */
//		led9: alert {
//			gpios = <&gpio_140_176 28 GPIO_ACTIVE_LOW>;
//		};
//	};

	voltage0: voltage12v {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 0>;
		io-channel-names = "12V";
		output-ohms = <3300>;
		full-ohms = <(10000+3300)>; 
	};
	voltage1: voltage5v {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 1>;
		io-channel-names = "5V";
		output-ohms = <10000>;
		full-ohms = <(10000+10000)>;
	};
	voltage2: voltage3v3alwon {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 2>;
		io-channel-names = "3.3VAlwaysOn";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	voltage3: voltage1v8alwon {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 3>;
		io-channel-names = "1.8VAlwaysOn";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	therm0: thermistor-0 {
		compatible = "murata,ncp15xh103";
		io-channels = <&adc0 4>;
		pullup-uv = <3300000>;
		pullup-ohm = <3300>;
		pulldown-ohm = <0>;
		friendly-name = "Ambient";
	};
	therm1: thermistor-1 {
		compatible = "murata,ncp15xh103";
		io-channels = <&adc0 5>;
		pullup-uv = <3300000>;
		pullup-ohm = <3300>;
		pulldown-ohm = <0>;
		friendly-name = "Core VR";
	};
	therm2: thermistor-2 {
		compatible = "murata,ncp15xh103";
		io-channels = <&adc0 6>;
		pullup-uv = <3300000>;
		pullup-ohm = <3300>;
		pulldown-ohm = <0>;
		friendly-name = "DDR";
	};
	voltage4: voltage1v8 {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 9>;
		io-channel-names = "1.8V";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	therm3: thermistor-3 {
		compatible = "murata,ncp15xh103";
		io-channels = <&adc0 10>;
		pullup-uv = <3300000>;
		pullup-ohm = <3300>;
		pulldown-ohm = <0>;
		friendly-name = "CPU";
	};
	voltage5: voltagevccinaux {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 11>;
		io-channel-names = "VCCinAux";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	voltage6: voltage1v064vdd2 {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 12>;
		io-channel-names = "1.06V_VDD2";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	voltage7: voltage0vttsodimm {
		compatible = "voltage-divider";
		status = "okay";
		io-channels = <&adc0 14>;
		io-channel-names = "VTT_SODIMM";
		output-ohms = <1>;
		full-ohms = <1>;
	};
	current0: voutpwrmon {
		compatible = "current-sense-amplifier";
		status = "okay";
		io-channels = <&adc0 15>;
		io-channel-names = "VOUT_PWRMON";
		sense-resistor-micro-ohms = <3>;
		sense-gain-mult = <50>;
	};

	smbus1: smbus1 {
		compatible = "microchip,xec-smbus";
		i2c = <&i2c_smb_3>;
		#address-cells = <1>;
		#size-cells = <0>;

		mfd3: mpq8788@31 {
			compatible = "mps,mpq8785";
			reg = <0x31>;

			mfd3_vin: mpq8788_31vin {
				compatible = "mps,mpq8785-vin";
				page = <0>;
				coefficients = <4 0 1>;
			};
			mfd3_vout: mpq8788_31vout {
				compatible = "mps,mpq8785-vout";
				page = <0>;
				coefficients = <512 0 0>;
			};
			mfd3_iout: mpq8788_31iout {
				compatible = "mps,mpq8785-iout";
				page = <0>;
				coefficients = <16 0 0>;
			};
			mfd3_temp: mpq8788_31temp {
				compatible = "mps,mpq8785-temp";
				page = <0>;
				coefficients = <1 0 0>;
			};
		};
		mfd4: mpq8788@32 {
			compatible = "mps,mpq8785";
			reg = <0x32>;

			mfd4_vin: mpq8788_32vin {
				compatible = "mps,mpq8785-vin";
				page = <0>;
				coefficients = <4 0 1>;
			};
			mfd4_vout: mpq8788_32vout {
				compatible = "mps,mpq8785-vout";
				page = <0>;
				coefficients = <512 0 0>;
			};
			mfd4_iout: mpq8788_32iout {
				compatible = "mps,mpq8785-iout";
				page = <0>;
				coefficients = <16 0 0>;
			};
			mfd4_temp: mpq8788_32temp {
				compatible = "mps,mpq8785-temp";
				page = <0>;
				coefficients = <1 0 0>;
			};
		};
		mfd5: mpq8790@30 {
			compatible = "mps,mpq8785";
			reg = <0x30>;

			mfd5_vin: mpq8790vin {
				compatible = "mps,mpq8785-vin";
				page = <0>;
				coefficients = <4 0 1>;
			};
			mfd5_vout: mpq8790vout {
				compatible = "mps,mpq8785-vout";
				page = <0>;
				coefficients = <512 0 0>;
			};
			mfd5_iout: mpq8790iout {
				compatible = "mps,mpq8785-iout";
				page = <0>;
				coefficients = <16 0 0>;
			};
			mfd5_temp: mpq8790temp {
				compatible = "mps,mpq8785-temp";
				page = <0>;
				coefficients = <1 0 0>;
			};
		};
		mfd6: crps@58 {
			compatible = "ocp,crps";
			reg = <0x58>;

			mfd6_temp_amb: crps58ambient {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <141>;
			};
			mfd6_temp_hot: crps58hot {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <142>;
			};
			mfd6_iout: crps58iout {
				compatible = "ocp,crps-iout";
				page = <0>;
			};
		};
		mfd7: mp2928@20 {
			compatible = "mps,mp2928";
			reg = <0x20>;

			mfd7_temp: mps2928_temp {
				compatible = "mps,mp2928-temp";
				page = <0>;
			};
			mfd7_vout: mps2928_vout_r0 {
				compatible = "mps,mp2928-vout";
				page = <0>;
			};
			mfd8_vout: mps2928_vout_r1 {
				compatible = "mps,mp2928-vout";
				page = <1>;
			};
			mfd9_vout: mps2928_vout_r2 {
				compatible = "mps,mp2928-vout";
				page = <2>;
			};
		};
		mfd8: crps@59 {
			compatible = "ocp,crps";
			reg = <0x59>;

			mfd8_temp_amb: crps59ambient {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <141>;
			};
			mfd8_temp_hot: crps59hot {
				compatible = "ocp,crps-temp";
				page = <0>;
				temp-reg = <142>;
			};
			mfd8_iout: crps59iout {
				compatible = "ocp,crps-iout";
				page = <0>;
			};
		};
	};

	zephyr,user {
//		signal-gpios = <&gpio_100_136 1 GPIO_ACTIVE_LOW>;
		pinctrl-0 = <&gpio101 &gpio102 &gpio172 &gpio173 &gpio_uc_2>;
		pinctrl-names = "default";
	};
};

&gpio_100_136 {
	n1 {
		gpio-hog;
		gpios = <16 GPIO_ACTIVE_HIGH>;
		output-high;
	};
};
//&gpio_140_176 {
